{
  "name": "md-file-icons",
  "version": "2.0.0",
  "description": "Material Design file icons based on CSS",
  "author": "Djamel Eddine Korei",
  "license": "MIT",
  "type": "module",
  "main": "dist/md-file-icons.css",
  "style": "dist/md-file-icons.css",
  "sass": "src/md-file-icons.scss",
  "exports": {
    ".": "./dist/md-file-icons.css",
    "./css": "./dist/md-file-icons.css",
    "./scss": "./src/md-file-icons.scss",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode lib",
    "build:site": "vite build --mode site",
    "preview": "vite preview",
    "watch": "vite build --mode lib --watch"
  },
  "devDependencies": {
    "lightningcss": "^1.30.2",
    "sass": "^1.83.0",
    "vite": "^8.2.2"
  },
  "keywords": [
    "css",
    "scss",
    "sass",
    "icon",
    "icons",
    "file-icon",
    "material-design",
    "md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djamelkorei/md-file-icons.git"
  },
  "bugs": {
    "url": "https://github.com/djamelkorei/md-file-icons/issues"
  },
  "homepage": "https://djamelkorei.github.io/md-file-icons/"
}
